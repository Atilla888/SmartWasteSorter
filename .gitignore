# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore Python virtual environments
venv/
backend/venv/

# Ignore Python cache
__pycache__/
*.pyc

# Ignore training datasets
training/dataset/
training/dataset_split/

# Ignore YOLO training outputs
training/model_output/

# Allow ONLY training scripts
!training/train.py
!training/README.md

# Backend model (commit this!)
!backend/models/
!backend/models/best.pt
# Allow ONNX exports
!backend/models/*.onnx

# Ignore weight checkpoints inside training
training/**/*.pt

