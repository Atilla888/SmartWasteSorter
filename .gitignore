# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore Python virtual environments
venv/
backend/venv/

# Ignore Python cache
__pycache__/
*.pyc

# Ignore training datasets
training/dataset/
training/dataset_split/

# Ignore YOLO weight checkpoints
training/model_output/run/weights/*.pt
training/model_output/run*/  # run, run2, run3, etc., except ONNX

# Do NOT ignore ONNX
!training/model_output/run/weights/*.onnx

# Ignore backend frames
backend/frames/

